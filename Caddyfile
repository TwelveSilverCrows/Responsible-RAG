# =============================================================================
# Caddyfile — Reverse proxy for RAG Chatbot
# =============================================================================
# The DOMAIN variable is read from .env (set DOMAIN=yourdomain.com).
# Caddy automatically provisions and renews SSL via Let's Encrypt.
# =============================================================================

{$DOMAIN:localhost} {
    # ── Frontend (Vite + React SPA) ──────────────────────────────────────────
    reverse_proxy localhost:3000

    # ── Backend (FastAPI) under /api/v1/ ──────────────────────────────────────
    handle /api/v1/* {
        request_body {
            max_size 500MB
        }
        reverse_proxy localhost:8000
    }

    # ── Logs ─────────────────────────────────────────────────────────────────
    log {
        output file /data/access.log
    }
}
