# =============================================================================
# example.env — Copy this file to .env and fill in your values.
# Never commit the real .env to version control.
# =============================================================================

# ── Domain (for reverse proxy / Caddy) ───────────────────────────────────────
# Set to your domain to enable HTTPS via Let's Encrypt.
# Leave empty to run on localhost (HTTP only).
DOMAIN=

# ── LangSmith (observability) ────────────────────────────────────────────────
# Enable tracing: set to true to see traces in LangSmith dashboard
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=rag-chatbot          # Project name in LangSmith UI

# ── LLM ───────────────────────────────────────────────────────────────────────
# Model identifier passed to LangChain's init_chat_model().
# Default is DeepSeek; swap for any supported provider model string.
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# DeepSeek API key (required when LLM_MODEL=deepseek-chat)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── Embedding backend ─────────────────────────────────────────────────────────
# --- Auto-detection (default) ---
# System auto-detects Intel CPU/NPU/GPU and uses OpenVINO if available.
# Falls back to Nomic if no Intel hardware is detected.
# Set USE_NOMIC=true to force Nomic backend.
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=CPU              # Fallback if auto-detection fails
USE_NOMIC=false                   # Set to true to force Nomic backend
EMBEDDING_NORMALIZE=true

# --- Nomic Embed (alternative) ---
# Set USE_NOMIC=true to use the Nomic local inference backend instead.
USE_NOMIC=false
NOMIC_DIMENSIONALITY=512

# ── Chunking ──────────────────────────────────────────────────────────────────
USE_SEMANTIC_CHUNKING=true
FALLBACK_CHUNK_SIZE=1000          # Characters per chunk (recursive fallback)
CHUNK_OVERLAP=200                 # Overlap between consecutive chunks
MAX_CHUNK_SIZE=2000               # Semantic chunks larger than this → fallback

# ── Retrieval ─────────────────────────────────────────────────────────────────
VEC_RETRIEVER_K=3                 # Top-k results from vector retriever
BM25_RETRIEVER_K=3                # Top-k results from BM25 retriever
VEC_WEIGHT=0.7                    # Must sum to 1.0 with BM25_WEIGHT
BM25_WEIGHT=0.3

# ── Storage paths ─────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db    # On-disk Chroma vector store location
RESOURCES_DIR=./resources         # Source documents to ingest (txt / pdf)
