# =============================================================================
# example.env — Copy this file to .env and fill in your values.
# Never commit the real .env to version control.
# =============================================================================

# ── Domain (for reverse proxy / Caddy) ───────────────────────────────────────
# Set to your domain to enable HTTPS via Let's Encrypt.
# Leave empty to run on localhost (HTTP only).
DOMAIN=

# ── LangSmith (observability) ────────────────────────────────────────────────
# Enable tracing: set to true to see traces in LangSmith dashboard
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=rag-chatbot          # Project name in LangSmith UI

# ── LLM ───────────────────────────────────────────────────────────────────────
# Model identifier passed to LangChain's init_chat_model().
# Default is DeepSeek; swap for any supported provider model string.
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# DeepSeek API key (required when LLM_MODEL=deepseek-chat)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── Embedding backend (Hugging Face Inference API) ────────────────────────────
# Uses the HF Inference API for feature extraction — no local GPU or heavy
# deps (torch / optimum / openvino) required.
# Get a free token at https://huggingface.co/settings/tokens
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
HUGGINGFACEHUB_API_TOKEN=hf_your_token_here

# ── Chunking ──────────────────────────────────────────────────────────────────
USE_SEMANTIC_CHUNKING=true
FALLBACK_CHUNK_SIZE=1000          # Characters per chunk (recursive fallback)
CHUNK_OVERLAP=200                 # Overlap between consecutive chunks
MAX_CHUNK_SIZE=2000               # Semantic chunks larger than this → fallback

# ── Retrieval ─────────────────────────────────────────────────────────────────
VEC_RETRIEVER_K=3                 # Top-k results from vector retriever
BM25_RETRIEVER_K=3                # Top-k results from BM25 retriever
VEC_WEIGHT=0.7                    # Must sum to 1.0 with BM25_WEIGHT
BM25_WEIGHT=0.3

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Connection string for the Docker MongoDB service.
# When running locally (outside Docker), use:
#   mongodb://rag:ragpassword@localhost:27017/responsible_rag?authSource=admin
# When running inside Docker Compose, the default from docker-compose.yml is
# used automatically and can be overridden here.
MONGO_URI=mongodb://rag:ragpassword@localhost:27017/responsible_rag?authSource=admin
MONGO_DB=responsible_rag
# MongoDB credentials (used by the container init script)
MONGO_ROOT_USER=rag
MONGO_ROOT_PASSWORD=ragpassword
MONGO_APP_USER=rag
MONGO_APP_PASSWORD=ragpassword

# ── Embedding API cooldown ─────────────────────────────────────────────────
# When the HuggingFace Inference API returns a quota/rate-limit error,
# embedding operations are paused for this many seconds to avoid repeated
# failures.  Default is 7200 (2 hours).
# EMBEDDING_COOLDOWN_SECONDS=7200

# ── Vector store (TurboVec) ──────────────────────────────────────────────
VECTORDATA_DIR=./vectordb         # On-disk TurboVec vector store location
TURBOVEC_BIT_WIDTH=4              # 2 or 4; higher = better quality

# ── Storage paths ─────────────────────────────────────────────────────────────
RESOURCES_DIR=./resources         # Source documents to ingest (txt / pdf)
UPLOAD_DIR=./uploads              # Temporary upload directory for ingestion

# ── Auth (JWT secret) ─────────────────────────────────────────────────────────
# Change this to a secure random string in production.
AUTH_SECRET_KEY=change-me-to-a-random-secret-in-production
AUTH_ALGORITHM=HS256

# ── Admin credentials ─────────────────────────────────────────────────────────
# Used to log in as admin (checked against .env, not the database).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ── SMTP (email verification) ─────────────────────────────────────────────────
# If left empty, verification emails are logged to console (dev mode).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Frontend URL ──────────────────────────────────────────────────────────────
# Used for OAuth redirects and email verification links from the backend.
# Dev:
#   - Local Vite dev server:   http://localhost:5173
#   - Docker (nginx port 3000): http://localhost:3000
# Prod: set to your domain with HTTPS
FRONTEND_URL=http://localhost:5173

# ── Vite API URL ─────────────────────────────────────────────────────────────
# Absolute URL for local dev without Caddy; relative (/api/v1) when behind
# the Caddy reverse proxy (production / Docker Compose full stack).
VITE_API_URL=http://localhost:8000/api/v1

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Add the GOOGLE_REDIRECT_URI below to "Authorized redirect URIs" in your
# Google Cloud Console OAuth client settings.
#
# Dev (local Vite):  http://localhost:8000/api/v1/auth/google/callback
# Dev (Docker):      http://localhost:8000/api/v1/auth/google/callback
# Prod:              https://YOUR_DOMAIN/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Frontend env (Vite) ───────────────────────────────────────────────────────
# These are baked in at build time by Vite. When running in Docker, pass them
# as build args in docker-compose.yml.
# Dev:  http://localhost:8000/api/v1
# Prod: https://YOUR_DOMAIN/api/v1
VITE_API_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ── Production overrides ──────────────────────────────────────────────────────
# When deploying, you MUST set DOMAIN in your .env and use the production
# docker-compose override file:
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build -d
#
# The prod override reads DOMAIN and sets the correct URLs automatically:
#   FRONTEND_URL:           https://{DOMAIN}
#   GOOGLE_REDIRECT_URI:    https://{DOMAIN}/api/v1/auth/google/callback
#   VITE_API_URL (build):   https://{DOMAIN}/api/v1
#
# If you run without the prod override, the frontend defaults to a relative
# /api/v1 path which works through Caddy but NOT if accessing the frontend
# directly. For production, always use the prod override file.
