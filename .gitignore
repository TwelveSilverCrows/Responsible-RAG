# =============================================================================
# .gitignore
# =============================================================================

# ── Secrets ───────────────────────────────────────────────────────────────────
.env

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/
*.pyo
*.pyd

# ── Virtual environments (pip / uv) ───────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── uv ────────────────────────────────────────────────────────────────────────
uv.lock         # Commit this if you want reproducible installs across machines;
                # uncomment the line below to ignore it instead:
# uv.lock

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Type checkers / linters ───────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/

# ── IDEs ─────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# ── Frontend (Bun/Node / Vite) ───────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/dist/
frontend/next-env.d.ts
frontend/*.tsbuildinfo
# Keep bun.lock committed if you want reproducible installs across machines:
frontend/bun.lock

# ── Project-specific data (moved to ../storage/ outside project tree) ────────
# All runtime data (vector store, profiles KB, uploads, MongoDB files) now
# lives at ../storage/ — a sibling directory outside the git repo — so git
# ignores it automatically.  No gitignore entry needed.
#
# Legacy local dirs (./vectordb, ./vectordb_profiles, ./resources, ./uploads):
# These are being phased out.  If they still exist locally, they are ignored:
resources/*
vectordb/*
vectordb_profiles/*
uploads/*

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml
