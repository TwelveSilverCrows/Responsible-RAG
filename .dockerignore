# =============================================================================
# .dockerignore — Keep the build context lean
# =============================================================================

# Version control
.git
.gitignore
.github

# Python artefacts
__pycache__
*.py[cod]
*$py.class
*.egg-info
dist
build
.eggs

# Virtual environments
.venv
venv
env

# uv artefacts
.uv

# Testing & tooling
.pytest_cache
.coverage
htmlcov
tests/

# Storage (large data files — mounted at runtime, not needed in the image)
storage/
../storage/

# Scripts (not installed in the image — only needed for dev/admin)
scripts/

# Docs
*.md
README.md
LICENSE
example.env

# Environment files
.env
.env.*

# Heavy data dirs (not needed for builds)
data/
vectordb/
vectordb_profiles/
resources/

# Source not needed for backend builds
frontend/
scripts/
tests/

# Environment files
.env
.tox
.mypy_cache
.ruff_cache

# IDE
.idea
.vscode
*.swp
*.swo
.DS_Store

# Secrets — never bake into the image
.env

# Local data — mounted as volumes at runtime instead
vectordb
resources

# Docs
*.md
